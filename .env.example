# Application Configuration
APP_NAME="Fluxor App"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_KEY=

# Database Configuration (avaliable in lizzyman04/fluxor-mvc-template)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fluxor_db
DB_USERNAME=root
DB_PASSWORD=

# Mail Configuration (avaliable in lizzyman04/fluxor-mvc-template)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Fluxor App"

# Upload Configuration (avaliable in lizzyman04/fluxor-mvc-template)
UPLOAD_MAX_SIZE=104857600
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp,svg,pdf,doc,docx,mp3,mp4